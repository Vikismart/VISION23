# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code files
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.php text eol=lf
*.py text eol=lf
*.ino text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary

# TensorFlow.js pre-trained model shards
vendor/models/** binary
group1-shard* binary
